<view class="wa-page">
  <!-- 头部 -->
  <view class="wa-hero-head">
    <view class="wa-eyebrow">YOUR WEALTH JOURNEY</view>
    <view class="wa-h1">测测你的<text class="wa-h1-em">财富段位</text></view>
    <view class="wa-subtitle">从 A1 到 A10，每一次积累，都是一次升级</view>
  </view>

  <!-- 主舞台 -->
  <view class="wa-stage">
    <view class="wa-crest-wrap">
      <view class="wa-halo"></view>
      <view class="wa-crest" style="{{stageVm && stageVm.crestRank !== '?' ? 'animation: wa-arrive .8s cubic-bezier(.2,1.6,.3,1) both;' : ''}}">
        <view class="wa-crest-inner">
          <view class="wa-crest-rank num">{{stageVm ? stageVm.crestRank : '?'}}</view>
          <view class="wa-crest-ribbon">WEALTH RANK</view>
        </view>
      </view>
      <view class="wa-rank-title">{{stageVm ? stageVm.rankTitle : '等待测算'}}</view>
      <view class="wa-rank-note">{{stageVm ? stageVm.rankNote : '输入你的资产，唤醒专属财富徽章'}}</view>
    </view>

    <view class="wa-stats-row">
      <view class="wa-side-stat">
        <view class="wa-micro">CURRENT ASSETS</view>
        <view class="wa-big-money num">{{stageVm ? stageVm.currentAmount : '--'}}</view>
        <view class="wa-stat-label">当前可用金融资产</view>
        <view class="wa-sparkline"></view>
        <view class="wa-micro">WEALTH CLASS</view>
        <view class="wa-stat-label">{{stageVm ? stageVm.classShow : '等待探索'}}</view>
      </view>
      <view class="wa-side-stat">
        <view class="wa-micro">NEXT CHALLENGE</view>
        <view class="wa-big-money wa-gold-text num">{{stageVm ? stageVm.gapAmount : '--'}}</view>
        <view class="wa-stat-label">距离下一个财富段位</view>
        <view class="wa-sparkline"></view>
        <view class="wa-micro">LEVEL MISSION</view>
        <view class="wa-stat-label">{{stageVm ? stageVm.nextRank : '等待解锁'}}</view>
      </view>
    </view>

    <view class="wa-stage-input">
      <view class="wa-input-line">
        <picker mode="selector" range="{{['个人', '家庭']}}" bindchange="onScopePick">
          <view class="wa-unit-select">{{scope}} ▾</view>
        </picker>
        <view class="wa-main-input-box">
          <input class="wa-main-input num" type="digit" value="{{assetDraft}}" placeholder="输入可用资产" placeholder-class="wa-placeholder" bindinput="onAssetInput" />
        </view>
        <picker mode="selector" range="{{['万元', '元']}}" bindchange="onUnitPick">
          <view class="wa-unit-select">{{unit === 'wan' ? '万元' : '元'}} ▾</view>
        </picker>
      </view>
      <view class="wa-micro-note">现金、存款、股票、基金等金融净资产，不含自住房及汽车</view>
      <view class="wa-button-main" bindtap="onExplore">{{stageVm ? stageVm.exploreText : '✦ 开启我的财富之旅'}}</view>
    </view>

    <view class="wa-stage-bottom">
      <view class="wa-bar-title">{{stageVm ? stageVm.barLabel : '财富成长进度 · 尚未开始'}}</view>
      <view class="wa-xp-track"><view class="wa-xp-fill" style="{{stageVm ? stageVm.barFillStyle : 'width: 0%;'}}"></view></view>
      <view class="wa-percentage num">{{stageVm ? stageVm.barPct : '0%'}}</view>
    </view>
    <view class="wa-stat-label" style="text-align: center; margin-top: 8rpx;">{{stageVm ? stageVm.nextTarget : '尚未开启'}}</view>
  </view>

  <!-- 财富段位图鉴 -->
  <view class="wa-section">
    <view class="wa-section-head">
      <view class="wa-section-title">
        <view class="wa-section-mark"><text>✦</text></view>
        <view><view class="wa-section-kicker">RANK COLLECTION</view><view class="wa-section-name">财富段位图鉴</view></view>
      </view>
    </view>
    <view class="wa-rank-path">
      <view tt:for="{{tiles}}" tt:for-item="t" tt:key="code" class="wa-rank-tile {{t.cls}}" style="{{t.emblemStyle && t.cls === 'active' ? 'border-color:#e6b76b;' : ''}}" bindtap="onTileTap" data-index="{{index}}">
        <view class="wa-state-icon">{{t.stateIcon}}</view>
        <view class="wa-mini-emblem" style="{{t.emblemStyle}}"><text>{{t.numText}}</text></view>
        <view class="wa-tile-code num">{{t.code}}</view>
        <view class="wa-tile-small">{{t.smallText}}</view>
      </view>
    </view>
    <view class="wa-path-footer">✧ A1–A10 按资产数量级划分，点击徽章查看段位门槛与解锁进度</view>
  </view>

  <!-- 下一站，财富升级 -->
  <view class="wa-section">
    <view class="wa-section-head">
      <view class="wa-section-title">
        <view class="wa-section-mark"><text>⌛</text></view>
        <view><view class="wa-section-kicker">THE NEXT MILESTONE</view><view class="wa-section-name">下一站，财富升级</view></view>
      </view>
    </view>
    <view class="wa-panel">
      <view class="wa-label">每月能存下多少钱？</view>
      <view class="wa-field-box">
        <input class="wa-field num" type="digit" value="{{monthlyDraft}}" placeholder="例如 5000" placeholder-class="wa-placeholder" bindinput="onMonthlyInput" />
        <text class="wa-field-unit">元 / 月</text>
      </view>
      <view class="wa-hint">扣除日常开销与贷款后的结余。输入后自动生成升级路线。</view>

      <view class="wa-label" style="margin-top: 30rpx;">从哪个月开始？</view>
      <view class="wa-field-row">
        <picker mode="selector" range="{{yearLabels}}" value="{{startYearIdx}}" bindchange="onStartYearPick">
          <view class="wa-field-box"><view class="wa-field-static num">{{yearLabels[startYearIdx]}} ▾</view></view>
        </picker>
        <picker mode="selector" range="{{monthLabels}}" value="{{startMonthIdx}}" bindchange="onStartMonthPick">
          <view class="wa-field-box"><view class="wa-field-static num">{{monthLabels[startMonthIdx]}} ▾</view></view>
        </picker>
      </view>
      <view class="wa-hint">按每月月底存入计算，默认从所选月份的下一月底开始。</view>

      <view class="wa-mission">
        <view class="wa-mission-kicker">✦ CURRENT QUEST</view>
        <view class="wa-mission-title">{{missionVm ? missionVm.title : '你的下一段冒险，等待开启'}}</view>
        <view class="wa-mission-desc">{{missionVm ? missionVm.desc : '先在上方输入可用资产，唤醒你的财富段位。'}}</view>
      </view>

      <block tt:if="{{milestoneCards.length > 0}}">
        <view class="wa-milestone-strip">
          <view tt:for="{{milestoneCards}}" tt:for-item="m" tt:key="amount" class="wa-milestone {{m.cls}}">
            <view class="wa-mcap">{{m.cap}}</view>
            <view class="wa-mvalue num">{{m.amount}}</view>
            <view class="wa-mtime">{{m.time}}</view>
          </view>
        </view>
      </block>

      <block tt:if="{{routePoints.length > 0}}">
        <view class="wa-toggle-btn" bindtap="onToggleRoute">{{routeOpen ? '收起完整成长路线 ↑' : '查看完整 A 级成长路线 ↓'}}</view>
        <view tt:if="{{routeOpen}}" class="wa-long-route">
          <view tt:for="{{routePoints}}" tt:for-item="p" tt:key="title" class="wa-route-point">
            <view class="wa-route-title num">{{p.title}}</view>
            <view class="wa-route-time">{{p.time}}</view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 财富策略工坊 -->
  <view class="wa-section">
    <view class="wa-section-head">
      <view class="wa-section-title">
        <view class="wa-section-mark"><text>⚡</text></view>
        <view><view class="wa-section-kicker">WEALTH STRATEGY LAB</view><view class="wa-section-name">财富策略工坊</view></view>
      </view>
    </view>
    <view class="wa-panel">
      <view class="wa-tabs">
        <view class="wa-tab {{tab === 'boost' ? 'active' : ''}}" bindtap="onTabTap" data-tab="boost">⚡ 升级加速器</view>
        <view class="wa-tab {{tab === 'reverse' ? 'active' : ''}}" bindtap="onTabTap" data-tab="reverse">◎ 目标倒推</view>
      </view>

      <block tt:if="{{tab === 'boost'}}">
        <view class="wa-label" style="margin-top: 28rpx;">挑战目标段位</view>
        <picker mode="selector" range="{{targetOptions}}" value="{{boostTargetIdx}}" bindchange="onBoostTargetPick">
          <view class="wa-field-box"><view class="wa-field-static">{{targetOptions[boostTargetIdx] || '先输入资产'}} ▾</view></view>
        </picker>
        <view class="wa-label" style="margin-top: 28rpx;">每月额外储蓄 <text class="wa-extra-value">{{extraValueText}}</text></view>
        <slider class="wa-range" min="0" max="10000" step="100" value="{{sliderVal}}" activeColor="#e8b96e" backgroundColor="#0a0e1a" block-size="22" bindchanging="onSliderInput" bindchange="onSliderInput" />
        <view class="wa-range-labels"><text>0</text><text>5,000</text><text>10,000</text></view>
        <view class="wa-field-box" style="margin-top: 20rpx;">
          <input class="wa-field num" type="digit" value="{{extraDraft}}" placeholder="0" placeholder-class="wa-placeholder" bindinput="onExtraInput" />
          <text class="wa-field-unit">元 / 月</text>
        </view>
        <view class="wa-pill-row">
          <view tt:for="{{boostChips}}" tt:for-item="c" tt:key="value" class="wa-chip {{c.selected ? 'selected' : ''}}" bindtap="onChipTap" data-extra="{{c.value}}">{{c.label}}</view>
        </view>

        <view tt:if="{{boostVm}}" class="wa-result-card">
          <view class="wa-mission-kicker">BOOST RESULT / 加速收益</view>
          <view class="wa-metric num">{{boostVm.metric}}</view>
          <view class="wa-stat-label">{{boostVm.sub}}</view>
          <view class="wa-comparisons">
            <view class="wa-compare"><text>原计划</text><view class="wa-compare-value num">{{boostVm.baseText}}</view></view>
            <view class="wa-compare"><text>加速计划</text><view class="wa-compare-value num">{{boostVm.boostText}}</view></view>
          </view>
          <view class="wa-hint">{{boostVm.foot}}</view>
        </view>
      </block>

      <block tt:if="{{tab === 'reverse'}}">
        <view class="wa-label" style="margin-top: 28rpx;">想要解锁的财富段位</view>
        <picker mode="selector" range="{{targetOptions}}" value="{{reverseTargetIdx}}" bindchange="onReverseTargetPick">
          <view class="wa-field-box"><view class="wa-field-static">{{targetOptions[reverseTargetIdx] || '先输入资产'}} ▾</view></view>
        </picker>
        <view class="wa-label" style="margin-top: 28rpx;">希望在什么时候达成？</view>
        <view class="wa-field-row">
          <picker mode="selector" range="{{yearLabels}}" value="{{goalYearIdx >= 0 ? goalYearIdx : 0}}" bindchange="onGoalYearPick">
            <view class="wa-field-box"><view class="wa-field-static num">{{yearLabels[goalYearIdx]}} ▾</view></view>
          </picker>
          <picker mode="selector" range="{{monthLabels}}" value="{{goalMonthIdx}}" bindchange="onGoalMonthPick">
            <view class="wa-field-box"><view class="wa-field-static num">{{monthLabels[goalMonthIdx]}} ▾</view></view>
          </picker>
        </view>
        <view class="wa-pill-row">
          <view class="wa-chip" bindtap="onGoalQuick" data-years="3">3 年后</view>
          <view class="wa-chip" bindtap="onGoalQuick" data-years="5">5 年后</view>
          <view class="wa-chip" bindtap="onGoalQuick" data-years="10">10 年后</view>
        </view>
        <view class="wa-hint" style="margin-top: 20rpx;">根据当前资产及目标期限，反推出每月需要存下的金额。</view>

        <view tt:if="{{reverseVm}}" class="wa-result-card">
          <view class="wa-mission-kicker">TARGET PLAN / 目标计划</view>
          <view class="wa-metric num">{{reverseVm.metric}}</view>
          <view class="wa-stat-label">{{reverseVm.sub}}</view>
          <view class="wa-comparisons">
            <view class="wa-compare"><text>目标资产门槛</text><view class="wa-compare-value num">{{reverseVm.amountText}}</view></view>
            <view class="wa-compare"><text>距离目标还差</text><view class="wa-compare-value num">{{reverseVm.gapText}}</view></view>
          </view>
          <view class="wa-hint">{{reverseVm.foot}}</view>
        </view>
      </block>
    </view>
  </view>

  <!-- 页脚：隐私 + 操作 -->
  <view class="wa-footer-panel">
    <view class="wa-footer-title">✧ 你的财富数据，只属于你</view>
    <view class="wa-footer-text">全部测算在本机本地完成，不上传资产信息。本工具仅用于金融知识趣味娱乐与数学模拟，非官方财富评级；测算结果不构成任何投资、理财、储蓄、交易或其他财务决策建议。</view>
    <view class="wa-save-row" bindtap="onRememberToggle">
      <view class="wa-check {{saveLocal ? 'on' : ''}}"><text tt:if="{{saveLocal}}">✓</text></view>
      <text class="wa-save-label">仅在这台设备上保存测算数据（下次打开自动恢复）</text>
    </view>
    <view class="wa-footer-btns">
      <view class="wa-toggle-btn" bindtap="onRulesOpen">计算规则</view>
      <view class="wa-toggle-btn" bindtap="onReset">清除数据</view>
    </view>
  </view>
  <view class="wa-footer-note">WEALTH A · LEVEL · 让财富成长变得看得见</view>

  <!-- 段位详情弹窗 -->
  <view tt:if="{{modal}}" class="wa-modal-shade" bindtap="onModalClose">
    <view class="wa-modal" catchtap="noop">
      <view class="wa-modal-head">
        <view class="wa-modal-title">{{modal.title}}</view>
        <view class="wa-modal-close" catchtap="onModalClose">×</view>
      </view>
      <view class="wa-modal-code num" style="color: {{modal.color}};">{{modal.code}}</view>
      <view tt:for="{{modal.lines}}" tt:for-item="line" tt:key="*this" class="wa-modal-line">{{line}}</view>
    </view>
  </view>

  <!-- 规则弹窗 -->
  <view tt:if="{{showRules}}" class="wa-modal-shade" bindtap="onModalClose">
    <view class="wa-modal" catchtap="noop">
      <view class="wa-modal-head">
        <view class="wa-modal-title">财富 A 级 · 计算规则与免责声明</view>
        <view class="wa-modal-close" catchtap="onModalClose">×</view>
      </view>
      <view class="wa-rules-banner">
        <view class="wa-rules-banner-title">金融娱乐声明</view>
        <view>本工具仅用于金融知识趣味娱乐和数学情景模拟。A1–A10 是自定义等级，不是官方或金融机构的财富评级。所有等级、储蓄计划、目标日期和预测结果均仅供娱乐参考，不构成任何投资、理财、储蓄、交易或其他财务决策建议，不保证未来资产增长或目标实现。请勿将结果作为实际金融决策依据。</view>
      </view>
      <view class="wa-rules-list">
        <view>· A1–A10 按金融净资产数量级划分，等级门槛依次为 0、10、100、1000、1 万、10 万、100 万、1000 万、1 亿、10 亿元。</view>
        <view>· 等级左闭右开，A10 为 10 亿元及以上，无上限。</view>
        <view>· 可用资产包含现金、存款、基金、股票等可支配金融净资产，不含自住房、汽车等非流动资产。</view>
        <view>· 按月末固定存款计算，第一笔新增储蓄发生在所选月份的下一月底。</view>
        <view>· 不计算投资收益、通货膨胀、收入及支出变化；超过 50 年显示为「超过 50 年」。</view>
        <view>· 数据只在本地计算；仅主动开启「本机保存」时才写入本机存储。</view>
      </view>
    </view>
  </view>
</view>
