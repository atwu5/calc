/* 财富 A 级测算：通用样式来自 app.ttss 的 tb-*，此处只放页面专属样式 */

/* 段位徽章 */
.w-badge-lg {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 8rpx 22rpx rgba(33, 30, 46, 0.22);
}
.w-badge-sm {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 2rpx 8rpx rgba(33, 30, 46, 0.18);
}
.w-badge-tl {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  flex-shrink: 0;
  border: 3rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 4rpx 12rpx rgba(33, 30, 46, 0.2);
}
.w-badge-tl-sm {
  font-size: 19rpx;
}

.w-badge-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.w-hero {
  margin-top: 6rpx;
  font-size: 50rpx;
  font-weight: 700;
  color: #211e2e;
  line-height: 1.3;
}
.w-pct {
  font-size: 24rpx;
  font-weight: 600;
  color: #ea580c;
}
.w-grid-value {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #211e2e;
}

/* 阶梯：5 列两行 */
.w-ladder {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.w-ladder-cell {
  width: calc((100% - 48rpx) / 5);
  min-width: 0;
  position: relative;
  border: 1rpx solid #eceaf2;
  border-radius: 16rpx;
  background: #ffffff;
  padding: 14rpx 4rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
}
.w-ladder-code {
  font-size: 18rpx;
  color: #a5a1b3;
  line-height: 1;
}
.w-ladder-mark {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  font-size: 17rpx;
  line-height: 1;
}
.w-detail {
  border: 1rpx solid #eceaf2;
  background: #fbfaff;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 21rpx;
  color: #6f6b80;
  line-height: 1.6;
}

/* 时间轴 */
.w-tl {
  display: flex;
  gap: 16rpx;
  padding-bottom: 24rpx;
}
.w-tl-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 76rpx;
  flex-shrink: 0;
}
.w-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ffffff;
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.w-dot-inner {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}
.w-rail {
  width: 4rpx;
  flex: 1;
  border-radius: 4rpx;
  margin-top: 10rpx;
  background: #e4e1ee;
}
.w-tl-card {
  flex: 1;
  min-width: 0;
  border: 1rpx solid #eceaf2;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}
.w-tl-card-now {
  border-color: #d8d2f5;
  background: #f7f6ff;
}
.w-tl-card-ms {
  border-style: dashed;
}
.w-tl-title {
  font-size: 24rpx;
}
.w-tl-amount {
  margin-left: 10rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #a5a1b3;
}
.w-tl-right {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #6f6b80;
}

/* 加速器滑块 */
.w-slider {
  margin: 10rpx 6rpx 0;
}

/* 金色高亮结论条 */
.w-gold {
  border-radius: 20rpx;
  border: 1rpx solid rgba(201, 162, 60, 0.4);
  background: linear-gradient(135deg, #fbf6e8, #fdfbf4);
  color: #8a6d14;
  padding: 20rpx 24rpx;
  font-size: 23rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.6;
}
/* 蓝紫高亮结论条 */
.w-blue {
  border-radius: 20rpx;
  border: 1rpx solid #e2ddfb;
  background: #f4f2ff;
  color: #4c3fd0;
  padding: 20rpx 24rpx;
  font-size: 23rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.6;
}

/* 快捷目标日期 chips */
.w-quick {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.w-quick-item {
  border: 1rpx solid #e4e1ee;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 8rpx 26rpx;
  font-size: 22rpx;
  color: #6f6b80;
}
.w-quick-item:active {
  border-color: #c9c2f2;
  color: #6d5bf6;
}

/* 保存开关行 */
.w-save-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

/* 输入错误提示 */
.w-error-text {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #e05252;
  line-height: 1.5;
}
